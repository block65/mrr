{
  "arrowParens": "always",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "printWidth": 80,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "useTabs": false,
  "semi": true,
  "sortPackageJson": true,
  "ignorePatterns": ["pnpm-lock.yaml", "node_modules", "dist", "build"],
}
